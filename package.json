{
  "name": "ccprof",
  "version": "0.3.0",
  "description": "Deterministic local profiler that reconciles Claude Code session logs with the final Git diff to show where minutes can be recovered in a PR.",
  "keywords": [
    "claude-code",
    "profiler",
    "pull-request",
    "developer-productivity",
    "cli"
  ],
  "homepage": "https://github.com/t09tanaka/ccprof#readme",
  "bugs": {
    "url": "https://github.com/t09tanaka/ccprof/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t09tanaka/ccprof.git"
  },
  "license": "MIT",
  "author": "Takuto Tanaka",
  "type": "module",
  "bin": {
    "ccprof": "dist/cli.js"
  },
  "exports": {
    "./adapter-sdk": {
      "types": "./dist/adapter-sdk/index.d.ts",
      "import": "./dist/adapter-sdk/index.js"
    },
    "./dist/*": "./dist/*",
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "schemas",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build:test && node --test .test-dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^20.0.0",
    "ajv": "8.17.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0"
  }
}
