{
  "name": "ccprof",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "ccprof": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
