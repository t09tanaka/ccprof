{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ccprof.dev/trace-envelope/v1.json",
  "title": "ccprof Trace Envelope v1",
  "description": "A forge- and producer-neutral envelope for coding-agent trace events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol_version",
    "producer",
    "trace_id",
    "span_id",
    "sequence",
    "timestamp",
    "work_unit",
    "event",
    "privacy",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.ccprof.dev/trace-envelope/v1.json"
    },
    "protocol_version": {
      "const": "1.0.0"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "trace_id": {
      "$ref": "#/$defs/trace_id"
    },
    "span_id": {
      "$ref": "#/$defs/span_id"
    },
    "parent_span_id": {
      "$ref": "#/$defs/span_id"
    },
    "sequence": {
      "$ref": "#/$defs/nonnegative_safe_integer"
    },
    "timestamp": {
      "$ref": "#/$defs/timestamp"
    },
    "work_unit": {
      "$ref": "#/$defs/work_unit"
    },
    "event": {
      "$ref": "#/$defs/event"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/provenance_entry"
      }
    }
  },
  "$defs": {
    "nonnegative_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "namespaced_name": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?:[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?:/[a-z][a-z0-9._-]{0,63})*(?![\\s\\S])"
    },
    "absolute_uri": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2048,
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+(?![\\s\\S])"
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^(?!0{32}(?![\\s\\S]))[0-9a-f]{32}(?![\\s\\S])"
    },
    "span_id": {
      "type": "string",
      "pattern": "^(?!0{16}(?![\\s\\S]))[0-9a-f]{16}(?![\\s\\S])"
    },
    "nanoseconds": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "json_pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/(?:[^~/\\n\\r\\u2028\\u2029]|~[01])*(?:/(?:[^~/\\n\\r\\u2028\\u2029]|~[01])*)*(?![\\s\\S])"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "instance_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/namespaced_name"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "instance_id": {
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_unix_ns",
        "monotonic_offset_ns",
        "uncertainty_ns"
      ],
      "properties": {
        "wall_time_unix_ns": {
          "$ref": "#/$defs/nanoseconds"
        },
        "monotonic_offset_ns": {
          "$ref": "#/$defs/nanoseconds"
        },
        "uncertainty_ns": {
          "$ref": "#/$defs/nanoseconds"
        }
      }
    },
    "work_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/namespaced_name"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        },
        "parent_id": {
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload_schema",
        "payload"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/absolute_uri"
        },
        "payload_schema": {
          "$ref": "#/$defs/absolute_uri"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "content_retained"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "sensitive",
            "restricted"
          ]
        },
        "content_retained": {
          "type": "boolean"
        }
      }
    },
    "provenance_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source",
        "method"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/json_pointer"
        },
        "source": {
          "$ref": "#/$defs/absolute_uri"
        },
        "method": {
          "enum": [
            "observed",
            "reported",
            "derived",
            "estimated"
          ]
        }
      }
    }
  }
}
