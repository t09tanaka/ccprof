{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/t09tanaka/ccprof/main/schemas/config.schema.json",
  "title": "ccprof repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "\\S"
    },
    "schema_version": {
      "const": 1
    },
    "test_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappings"],
      "properties": {
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "tests", "commands"],
            "properties": {
              "source": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "tests": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "minimum_privacy": {
          "enum": ["strict", "balanced", "raw"]
        },
        "allow_raw": {
          "type": "boolean"
        },
        "allow_advisory": {
          "type": "boolean"
        },
        "allow_export": {
          "type": "boolean"
        },
        "raw_retention_days_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "required_source_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_cohort_size": {
          "type": "integer",
          "minimum": 3,
          "maximum": 1000
        },
        "approval_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "x-ccprof-runtime-constraints": [
            "UTF-8 byte limits are enforced by runtime",
            "NFC and whitespace normalization are enforced by runtime",
            "normalized duplicate rejection is enforced by runtime",
            "data descriptor and proxy rejection is enforced by runtime",
            "canonical signed payload byte limit is enforced by runtime",
            "full tuple ordering uses UTF-8 bytes at runtime",
            "monotonic merge rules are enforced by runtime"
          ],
          "properties": {
            "safe_patterns": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "allow_rule_recommendation": { "type": "boolean" }
          }
        },
        "resource_domains": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["match", "domain", "parallel_safe"],
            "x-ccprof-runtime-constraints": [
              "UTF-8 byte limits are enforced by runtime",
              "NFC and whitespace normalization are enforced by runtime",
              "normalized duplicate rejection is enforced by runtime",
              "data descriptor and proxy rejection is enforced by runtime",
              "canonical signed payload byte limit is enforced by runtime",
              "full tuple ordering uses UTF-8 bytes at runtime",
              "monotonic merge rules are enforced by runtime"
            ],
            "properties": {
              "match": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "domain": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "parallel_safe": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
